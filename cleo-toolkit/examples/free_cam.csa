{$CLEO .csa}
// 车辆自由视角 - 摇杆滑动后 5 秒延迟回正（.csa 自动运行，GTASA Mobile）
// 逻辑：滑动摇杆 → 相机进入自由视角（每帧挂车带偏移，防止回正）
//       停止滑动后计时 300 帧（约 5 秒）内保持；超时 → 回正（相机回身后）

0000:

// ---- 初始化 ----
0007: 0@ = 0.0   // X 偏移（缩放后）
0007: 1@ = 0.0   // Y 偏移（缩放后）
0007: 2@ = 0.0   // 当前 X 偏移（摇杆原始值）
0007: 3@ = 0.0   // 当前 Y 偏移（摇杆原始值）
0006: 4@ = 0     // 帧计数
0006: 5@ = 0     // 自由视角开关（0/1）
0006: 6@ = 0     // 玩家车 handle
wait 1000

:MAIN
wait 0
if
00DF: actor $PLAYER_ACTOR driving
then
    // 玩家在车里：拿车 + 读摇杆
    03C0: 6@ = actor $PLAYER_ACTOR car
    0A4A: store_joystick_X_offset_to 2@ Y_offset_to 3@

    // 有滑动 → 进入自由视角，重置计时，偏移缩放为米
    if or
    0027: 2@ > 0.5
    0027: 3@ > 0.5
    then
        0006: 5@ = 1
        0006: 4@ = 0
        0007: 0@ = 2@
        0012: 0@ *= 0.01
        0007: 1@ = 3@
        0012: 1@ *= 0.01
    end

    // 自由视角中：帧计数，超过 300 帧（约 5 秒）回正
    if
    0027: 5@ > 0
    then
        0008: 4@ += 1
        if
        001E: 4@ > 300
        then
            0006: 5@ = 0
            0373: set_camera_directly_behind_player
        end
    end
else
    // 不在车上：复位状态
    0006: 5@ = 0
    0006: 4@ = 0
end

// 自由视角保持：每帧相机挂车带偏移（防止游戏自动回正）
if
0027: 5@ > 0
then
    0679: put_camera_on_car 6@ with_offset 0@ 1@ 0.0 rotation 0.0 0.0 0.0 tilt 0.0 switchstyle 0
end
0002: jump @MAIN
