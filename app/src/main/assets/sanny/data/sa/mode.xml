<?xml version="1.0" encoding="UTF-8"?>
<!--
    Edit-mode definition for CLEO Builder (Android).

    Opcode data: GTA Modding Community Opcode Database
    (https://gtagmodding.com/opcode-database/ , https://gtamods.com/wiki/List_of_opcodes)
 -->

<mode id="sa" title="GTA SA v1.0" game="sa">
    <data>data/sa/</data>
    <opcodes>data/sa/SASCM.ini</opcodes>
    <opcodes>data/sa/SASCM.CLEO.ini</opcodes>
    <opcodes>data/sa/SASCM.Clipboard.ini</opcodes>
    <opcodes>data/sa/SASCM.NewOpcodes.ini</opcodes>
    <opcodes>data/sa/SASCM.CLEO+.ini</opcodes>
    <opcodes>data/sa/SASCM*.ini</opcodes>
    <classes>data/sa/classes.db</classes>
    <enums>data/sa/enums.txt</enums>
    <variables>data/sa/CustomVariables.ini</variables>
    <keywords>data/sa/keywords.txt</keywords>
    <labels>data/sa/CustomLabels.ini</labels>
    <arrays>data/sa/CustomArrays.ini</arrays>
    <missions>data/sa/missions.txt</missions>
    <constants>data/sa/constants.txt</constants>
    <examples>data/sa/opcodes.txt</examples>
    <templates type="default">data/sa/templates.txt</templates>
    <templates type="custom">data/sa/templates.custom.txt</templates>
    <text format="sa">game/text/american.gxt</text>
    <ide base="game/">game/data/default.dat</ide>
    <ide base="game/">game/data/gta.dat</ide>
    <library>data/sa_sbl/sa.json</library>
    <copy-directory type="scm">game/data/script</copy-directory>
    <copy-directory type="cleo">game/CLEO</copy-directory>
</mode>