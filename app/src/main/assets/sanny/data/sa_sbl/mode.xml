<?xml version="1.0" encoding="UTF-8"?>
<!--
    Edit-mode definition for CLEO Builder (Android).

    Opcode data: GTA Modding Community Opcode Database
    (https://gtagmodding.com/opcode-database/ , https://gtamods.com/wiki/List_of_opcodes)
 -->

<mode id="sa_sbl" title="GTA SA (v1.0 - SBL)" game="sa" type="default">
    <data>data/sa_sbl/</data>
    
    <!-- main files -->
    <library autoupdate="yes">data/sa_sbl/sa.json</library>
    <classes autoupdate="yes">data/sa_sbl/classes.db</classes>
    <classes>data/sa_sbl/clipboard.fix.db</classes>
    <enums autoupdate="yes">data/sa_sbl/enums.txt</enums>
    <constants>data/sa_sbl/constants.txt</constants>
    <ide base="game/">game/data/default.dat</ide>
    <ide base="game/">game/data/gta.dat</ide>
    <keywords>data/sa_sbl/keywords.txt</keywords>
    <cleo-default-extensions>data/cleo5_extensions.sbf</cleo-default-extensions>

    <!-- decompiling -->
    <variables>data/sa_sbl/CustomVariables.ini</variables>
    <labels>data/sa_sbl/CustomLabels.ini</labels>
    <arrays>data/sa_sbl/CustomArrays.ini</arrays>
    <missions>data/sa_sbl/missions.txt</missions>
    <text format="sa">game/text/american.gxt</text>

    <!-- ide -->
    <templates type="default">data/sa_sbl/templates.txt</templates>
    <templates type="custom">data/sa_sbl/templates.custom.txt</templates>

    <!-- compiling -->
    <copy-directory type="scm">game/data/script</copy-directory>
    <copy-directory type="cleo">game/CLEO</copy-directory>
</mode>